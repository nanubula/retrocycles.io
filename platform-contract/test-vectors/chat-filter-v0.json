{
  "description": "The local word filter of platform-contract/README.md section 5. The terms are made up, so the vectors stay readable. 'expected' is 'text' with every mask and block match masked, 'masked' says whether anything was replaced, 'blocked' whether a block term was among the matches. A server given 'filter' as its chatFilter that decides a line itself (timeout, failing platform) drops it when 'blocked' is true (the sender gets the drop notice; nothing is delivered, not even masked) and delivers 'expected' otherwise. The platform's word-list classifier must find a match in exactly the cases with masked true, and a block term (a drop verdict) in exactly those with blocked true.",
  "filter": {
    "version": "test-vectors-v0",
    "mask": ["darn", "heck*", "*bloop*", "dump"],
    "block": ["zorp", "frak off"],
    "allow": ["kill", "frag", "core dump", "cut him off", "bloopers"]
  },
  "cases": [
    { "name": "clean line", "text": "hello all, gg", "expected": "hello all, gg", "masked": false, "blocked": false },
    { "name": "plain word", "text": "darn it", "expected": "**** it", "masked": true, "blocked": false },
    { "name": "upper case", "text": "DARN it", "expected": "**** it", "masked": true, "blocked": false },
    { "name": "plain words match whole words only", "text": "darnit", "expected": "darnit", "masked": false, "blocked": false },
    { "name": "two matches", "text": "darn darn", "expected": "**** ****", "masked": true, "blocked": false },
    { "name": "leet digit", "text": "d4rn", "expected": "****", "masked": true, "blocked": false },
    { "name": "leet sign", "text": "d@rn", "expected": "****", "masked": true, "blocked": false },
    { "name": "leet in a prefix term", "text": "h3ck yeah", "expected": "**** yeah", "masked": true, "blocked": false },
    { "name": "digits without letters stay digits", "text": "1337 and 100 darn", "expected": "1337 and 100 ****", "masked": true, "blocked": false },
    { "name": "spaced letters", "text": "d a r n you", "expected": "* * * * you", "masked": true, "blocked": false },
    { "name": "dotted letters", "text": "d.a.r.n", "expected": "*.*.*.*", "masked": true, "blocked": false },
    { "name": "dotted letters ending in a sign", "text": "d.a.r.n!", "expected": "*.*.*.*!", "masked": true, "blocked": false },
    { "name": "repeated letters", "text": "daaaarn", "expected": "*******", "masked": true, "blocked": false },
    { "name": "prefix term", "text": "heckin good", "expected": "****** good", "masked": true, "blocked": false },
    { "name": "substring term", "text": "megabloopy", "expected": "**********", "masked": true, "blocked": false },
    { "name": "allow covers a substring match", "text": "nice bloopers", "expected": "nice bloopers", "masked": false, "blocked": false },
    { "name": "block term", "text": "zorp", "expected": "****", "masked": true, "blocked": true },
    { "name": "phrase", "text": "frak off now", "expected": "**** *** now", "masked": true, "blocked": true },
    { "name": "half a phrase", "text": "frak", "expected": "frak", "masked": false, "blocked": false },
    { "name": "game talk", "text": "kill him, frag them, cut him off", "expected": "kill him, frag them, cut him off", "masked": false, "blocked": false },
    { "name": "allowed phrase covers a mask term", "text": "core dump again", "expected": "core dump again", "masked": false, "blocked": false },
    { "name": "mask term outside the allowed phrase", "text": "dump it", "expected": "**** it", "masked": true, "blocked": false },
    { "name": "colour code before a word", "text": "0xff0000darn", "expected": "0xff0000****", "masked": true, "blocked": false },
    { "name": "colour code inside a word", "text": "da0x00ff00rn", "expected": "**0x00ff00**", "masked": true, "blocked": false },
    { "name": "accent (UTF-8)", "text": "dárn", "expected": "****", "masked": true, "blocked": false },
    { "name": "punctuation around", "text": "(darn!)", "expected": "(****!)", "masked": true, "blocked": false },
    { "name": "a sign at the end is read both ways", "text": "zorp!", "expected": "****!", "masked": true, "blocked": true },
    { "name": "a sign at the start read as a letter", "text": "8loop", "expected": "*****", "masked": true, "blocked": false },
    { "name": "a sign at the start read as punctuation", "text": "@darn", "expected": "@****", "masked": true, "blocked": false },
    { "name": "allow does not cover a longer match", "text": "kill darn", "expected": "kill ****", "masked": true, "blocked": false },
    { "name": "block and mask terms in one line", "text": "darn zorp", "expected": "**** ****", "masked": true, "blocked": true },
    { "name": "block term in leet", "text": "z0rp", "expected": "****", "masked": true, "blocked": true },
    { "name": "block term in spaced letters", "text": "z o r p it", "expected": "* * * * it", "masked": true, "blocked": true },
    { "name": "block term inside a longer word is no match", "text": "zorpy", "expected": "zorpy", "masked": false, "blocked": false }
  ]
}
